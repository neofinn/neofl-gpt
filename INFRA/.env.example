# Gateway
NEOFL_GATEWAY_TOKEN=replace-with-a-long-random-token

# Reasoning provider: auto | openai | ollama
NEOFL_REASONER=auto
NEOFL_REASONING_MODEL=qwen3:8b
NEOFL_OLLAMA_URL=http://127.0.0.1:11434
# OPENAI_API_KEY=replace-me

# Optional durable memory
# NEOFL_SUPABASE_URL=https://your-project.supabase.co
# NEOFL_SUPABASE_SERVICE_ROLE_KEY=replace-me

# Local infrastructure
POSTGRES_DB=neofl
POSTGRES_USER=neofl
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_PORT=5432
REDIS_PORT=6379
