# Copy to .env on the GPU instance; never commit real secrets.
NEOFL_GATEWAY_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
NEOFL_REASONER=ollama
NEOFL_REASONING_MODEL=qwen3:8b
GATEWAY_PORT=8787
GATEWAY_BIND=127.0.0.1
OLLAMA_PORT=11434
# Optional durable cloud memory:
NEOFL_SUPABASE_URL=
NEOFL_SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_DB=neofl
POSTGRES_USER=neofl
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_PORT=5432
REDIS_PORT=6379
